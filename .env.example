# Salin ke .env dan isi kredensial PostgreSQL lokal.
# Password dengan karakter khusus wajib di-URL-encode di connection string.
DATABASE_URL="postgresql://sellin_app:CHANGE_ME@127.0.0.1:5432/sellin_dev?schema=public"

# Only development can disable these protections. Production always enables them.
AUTH_CSRF_ENABLED="false"
AUTH_RATE_LIMIT_ENABLED="false"
# Required in production, e.g. https://sellin.example.com (no trailing slash).
APP_ORIGIN="http://localhost:3000"
# Jangan gunakan prefix NEXT_PUBLIC_ untuk secret atau kredensial database.
